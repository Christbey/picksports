APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_BETA_ENABLED=true
APP_BETA_LABEL=BETA

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Optional local production-derived NBA snapshot connection
NBA_SNAPSHOT_DB_HOST=127.0.0.1
NBA_SNAPSHOT_DB_PORT=3306
NBA_SNAPSHOT_DB_DATABASE=picksports_prod_nba_snapshot
NBA_SNAPSHOT_DB_USERNAME=root
NBA_SNAPSHOT_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Optional legacy heartbeat (used for live scoreboard jobs when no Forge URL is set)
# HEARTBEAT_LIVE_SCOREBOARD_URL=

NBA_WIN_PROBABILITY_CALIBRATION_ENABLED=false
NBA_WIN_PROBABILITY_CALIBRATION_APPLY_TO_LIVE_OUTPUT=false
# NBA_WIN_PROBABILITY_CALIBRATION_ARTIFACT=/absolute/path/to/nba_win_probability_calibration_model.json

# Forge heartbeat URLs (one per scheduled task name, normalized to SCREAMING_SNAKE_CASE)
# Example schedule name: "NBA: Live Scoreboard Sync"
# FORGE_HEARTBEAT_NBA_LIVE_SCOREBOARD_SYNC_URL=
# Example schedule name: "Queue: Prune Failed Jobs"
# FORGE_HEARTBEAT_QUEUE_PRUNE_FAILED_JOBS_URL=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_TIMEOUT=10
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
MAILGUN_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Team logos use the standard S3-compatible disk by default.
# For DigitalOcean Spaces, use the AWS_* vars above with:
# AWS_ENDPOINT=https://<region>.digitaloceanspaces.com
# AWS_URL=https://<bucket>.<region>.digitaloceanspaces.com
TEAM_LOGOS_DISK=s3
TEAM_LOGOS_DIRECTORY=team-logos
TEAM_LOGOS_MIRROR=false

# Shared sports asset mirroring into the S3-compatible bucket.
SPORTS_ASSETS_DISK=s3
SPORTS_ASSETS_DIRECTORY=sports
SPORTS_ASSETS_MIRROR=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

STRIPE_PRICE_BASIC_MONTHLY=
STRIPE_PRICE_BASIC_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=

# Toggle paid tier/subscription enforcement.
# false = free-access mode, true = enforce subscription tiers/permissions.
ENFORCE_TIERS=false
# Comma-separated user IDs that bypass enforcement when ENFORCE_TIERS=true.
ENFORCE_TIERS_BYPASS_USER_IDS=

FOUNDING_USERS_ENABLED=false
FOUNDING_USERS_LIMIT=0
FOUNDING_USERS_ROLE=founding_user
FOUNDING_USERS_TIER_SLUG=premium

VITE_APP_NAME="${APP_NAME}"
VITE_STRIPE_KEY="${STRIPE_KEY}"

WEB_PUSH_VAPID_SUBJECT=mailto:support@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

TWILIO_WHATSAPP_ACCOUNT_SID=
TWILIO_WHATSAPP_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

COLLEGEFOOTBALLDATA_API_KEY=
COLLEGEFOOTBALLDATA_BASE_URL=https://api.collegefootballdata.com

AI_DEFAULT_PROVIDER=openai
AI_REQUEST_TIMEOUT=30
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_SPORTS_NARRATIVE_PROVIDER=openai
AI_SPORTS_NARRATIVE_MODEL=${OPENAI_MODEL}
AI_SPORTS_NARRATIVE_TIMEOUT_SECONDS=8
AI_PLAYER_PROP_NARRATIVE_PROVIDER=openai
AI_PLAYER_PROP_NARRATIVE_MODEL=${OPENAI_MODEL}
AI_PLAYER_PROP_NARRATIVE_TIMEOUT_SECONDS=8
AI_VALIDATION_REVIEW_SUMMARY_ENABLED=false
AI_VALIDATION_REVIEW_SUMMARY_PROVIDER=openai
AI_VALIDATION_REVIEW_SUMMARY_MODEL=${OPENAI_MODEL}
AI_VALIDATION_REVIEW_SUMMARY_TIMEOUT_SECONDS=8
VALIDATION_REGRESSION_ALERTS_ENABLED=true
VALIDATION_REGRESSION_FAILING_DELTA_THRESHOLD=1
VALIDATION_REGRESSION_WARNING_DELTA_THRESHOLD=2
AI_DAILY_DIGEST_SUMMARY_ENABLED=false
AI_DAILY_DIGEST_SUMMARY_PROVIDER=openai
AI_DAILY_DIGEST_SUMMARY_MODEL=${OPENAI_MODEL}
AI_DAILY_DIGEST_SUMMARY_TIMEOUT_SECONDS=8
NBA_PREDICTION_NARRATIVE_PROVIDER=template
NBA_PREDICTION_NARRATIVE_MODEL=${AI_SPORTS_NARRATIVE_MODEL}
NBA_PREDICTION_NARRATIVE_TEMPERATURE=0.2
NBA_PREDICTION_NARRATIVE_MAX_TOKENS=220
NBA_PREDICTION_NARRATIVE_TIMEOUT_SECONDS=${AI_SPORTS_NARRATIVE_TIMEOUT_SECONDS}
NBA_PREDICTION_NARRATIVE_TRENDS_SAMPLE_SIZE=16
NBA_PREDICTION_NARRATIVE_TRENDS_TIER=basic
